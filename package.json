{
  "name": "agent-harness",
  "version": "0.14.0",
  "private": true,
  "description": "Adapter-driven control plane for coding-agent work: goals, milestones, acceptance, verification summaries, and state sync.",
  "type": "module",
  "bin": {
    "agent-harness": "./plugins/agent-harness/scripts/agent-harness.mjs"
  },
  "scripts": {
    "doctor": "node plugins/agent-harness/scripts/agent-harness.mjs doctor",
    "deploy:local-plugin": "node tools/deploy-local-plugin.mjs",
    "deploy:local-plugin:portable": "node tools/deploy-local-plugin.mjs --allow-portable-validation",
    "print-contract": "node plugins/agent-harness/scripts/agent-harness.mjs print-contract",
    "test:all": "node scripts/test-suites.mjs all",
    "test:routing-classification": "node evals/run-agent-harness-eval.mjs",
    "test:eval": "node evals/run-agent-harness-eval.mjs",
    "test:eval:live": "node evals/run-live-skill-activation.mjs",
    "test:presentation": "node scripts/test-suites.mjs presentation",
    "test:protocol": "node scripts/test-suites.mjs protocol",
    "test:hosts-codex": "node scripts/test-suites.mjs hosts-codex",
    "test:hosts-grok": "node scripts/test-suites.mjs hosts-grok",
    "test:smoke": "node tests/smoke.mjs",
    "test:regressions": "node tests/regressions.mjs",
    "validate:plugin": "node tools/validate-plugin.mjs",
    "test:delivery-control": "node --test tests/delivery-control.mjs",
    "test:eval:development": "node evals/run-live-development.mjs",
    "validate:plugin:local": "node tools/validate-plugin-local.mjs"
  },
  "license": "MIT"
}
